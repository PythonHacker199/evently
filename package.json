{
  "name": "eventwise",
  "version": "1.0.0",
  "description": "GenAI-powered planning assistant for weddings, birthdays and community events: budgets, timelines, vendor checklists and personalised ideas (Gemini).",
  "type": "module",
  "main": "server.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "dev:web": "npm --prefix web run dev",
    "setup": "npm --prefix web ci",
    "build": "npm --prefix web run build",
    "test": "node --test"
  }
}
